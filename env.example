# Copy to .env for local dev. NEVER commit real values.
# In Netlify, set these under Site configuration > Environment variables.
# Use TEST values for Deploy Previews and branch deploys; LIVE values only in Production.

# --- Browser-safe (bundled into the app) ---
VITE_SUPABASE_URL=https://rvcidhzqwbmsqtgotidf.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Server-only (Netlify Functions). Never prefix with VITE_ ---
SUPABASE_URL=https://rvcidhzqwbmsqtgotidf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32 random bytes, base64. Generate with: openssl rand -base64 32
ANSWERS_ENC_KEY=
# Bump when rotating keys; keep the old key as ANSWERS_ENC_KEY_<old version> until re-encrypted.
ANSWERS_ENC_KEY_VERSION=1

# Random string used to hash IP addresses in the consent log. openssl rand -hex 32
IP_HASH_SALT=

# --- Owner decisions (Section 0). Placeholders until decided. ---
PRICE_CENTS=
ACCESS_DAYS=
REFUND_DAYS=
DRAFT_RETENTION_DAYS=
UPLOAD_RETENTION_DAYS=
SUPPORT_EMAIL=ettrickc@gmail.com
STRIPE_STATEMENT_DESCRIPTOR=

# --- Stripe (added in build step 6). TEST keys only until owner says go live. ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
